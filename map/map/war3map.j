call SaveStr(AC, StringHash("物品名字"), LoadInteger(AC, StringHash("遍历物品"), StringHash("遍历上限")), "斩仙魔刃(仙器)")
call SaveInteger(AC, StringHash("遍历物品"), StringHash("遍历上限"), LoadInteger(AC, StringHash("遍历物品"), StringHash("遍历上限")) + 1)
call SaveInteger(AC, StringHash("遍历物品"), LoadInteger(AC, StringHash("遍历物品"), StringHash("遍历上限")), 0x5A303832)
call SaveStr(AC, StringHash("物品名字"), LoadInteger(AC, StringHash("遍历物品"), StringHash("遍历上限")), "魔族遗章(Z)")
endfunction
function XYRMax takes real a,real b returns real
if ( a < b ) then
return b
else
return a
endif
endfunction
function ModName takes string name returns integer
local integer i=1
if LoadInteger(AC, StringHash(name), StringHash("模型ID")) > 0 then
return LoadInteger(AC, StringHash(name), StringHash("模型ID"))
endif
loop
exitwhen i > LoadInteger(AC, StringHash("遍历单位"), StringHash("遍历上限"))
if LoadStr(AC, StringHash("遍历名字"), i) == name then
call SaveInteger(AC, StringHash(name), StringHash("模型ID"), LoadInteger(AC, StringHash("遍历单位"), i))
return LoadInteger(AC, StringHash("遍历单位"), i)
endif
set i=i + 1
endloop
return 0
endfunction
function SikllName takes string name returns integer
local integer i=1
if LoadInteger(AC, StringHash("技能" + name), StringHash("模型ID")) > 0 then
return LoadInteger(AC, StringHash("技能" + name), StringHash("模型ID"))
endif
loop
exitwhen i > LoadInteger(AC, StringHash("遍历技能"), StringHash("遍历上限"))
if LoadStr(AC, StringHash("技能名字"), i) == name then
call SaveInteger(AC, StringHash("技能" + name), StringHash("模型ID"), LoadInteger(AC, StringHash("遍历技能"), i))
return LoadInteger(AC, StringHash("遍历技能"), i)
endif
set i=i + 1
endloop
return 0
endfunction
function ItemName takes string name returns integer
local integer i=1
if LoadInteger(AC, StringHash("物品" + name), StringHash("模型ID")) > 0 then
return LoadInteger(AC, StringHash("物品" + name), StringHash("模型ID"))
endif
loop
exitwhen i > LoadInteger(AC, StringHash("遍历物品"), StringHash("遍历上限"))
if LoadStr(AC, StringHash("物品名字"), i) == name then
call SaveInteger(AC, StringHash("物品" + name), StringHash("模型ID"), LoadInteger(AC, StringHash("遍历物品"), i))
return LoadInteger(AC, StringHash("遍历物品"), i)
endif
set i=i + 1
endloop
return 0
endfunction
function UnitAddAbilityLevel takes unit dw,integer abilityId,integer level,boolean t returns nothing
call UnitAddAbility(dw, abilityId)
call SetUnitAbilityLevel(dw, abilityId, level)
if t then
call UnitMakeAbilityPermanent(dw, true, abilityId)
endif
endfunction
function UnitAddBuffSystem takes unit dw,unit dw2,real Duration,real s,integer BuffType returns nothing
local unit mj=CreateUnit(GetOwningPlayer(dw), ModNameSystem__BuffMaJia[1], GetUnitX(dw2), GetUnitY(dw2), bj_UNIT_FACING)
call UnitApplyTimedLife(mj, 0x42487765, 3.00)
call UnitAddAbility(mj, ModNameSystem__BuffSkillId[BuffType])
if BuffType == 1 then
call IssueTargetOrder(mj, "faeriefire", dw2)
call SetUnitState(dw2, ConvertUnitState(0x20), ( GetUnitState(dw2, ConvertUnitState(0x20)) - s ))
if IsUnitInGroup(dw2, ModNameSystem__buffdwz) == false then
call GroupAddUnit(ModNameSystem__buffdwz, dw2)
endif
call SaveReal(AC, GetHandleId(dw2), StringHash("减防持续时间"), LoadReal(AC, GetHandleId(dw2), StringHash("减防持续时间")) + Duration)
call SaveReal(AC, GetHandleId(dw2), StringHash("减防数值"), LoadReal(AC, GetHandleId(dw2), StringHash("减防数值")) + s)
elseif BuffType == 2 then
call SetUnitAbilityLevel(mj, ModNameSystem__BuffSkillId[BuffType], R2I(XYRMax(1 , s / 25)))
call IssueTargetOrder(mj, "slow", dw2)
elseif BuffType == 3 then
call SetUnitAbilityLevel(mj, ModNameSystem__BuffSkillId[BuffType], R2I(XYRMax(1 , s)))
call IssueTargetOrder(mj, "entanglingroots", dw2)
elseif BuffType == 4 then
call SetUnitAbilityLevel(mj, ModNameSystem__BuffSkillId[BuffType], R2I(XYRMax(1 , s * 0.5)))
call IssueTargetOrder(mj, "firebolt", dw2)
endif
set mj=null
endfunction
function XYIsUnitDead takes unit whichUnit returns boolean
return GetUnitState(whichUnit, UNIT_STATE_LIFE) <= 0.3
endfunction
function BuffGroupD takes nothing returns nothing
if LoadReal(AC, GetHandleId(GetEnumUnit()), StringHash("减防持续时间")) > 0.00 then
call SaveReal(AC, GetHandleId(GetEnumUnit()), StringHash("减防持续时间"), LoadReal(AC, GetHandleId(GetEnumUnit()), StringHash("减防持续时间")) - 0.02)
if LoadReal(AC, GetHandleId(GetEnumUnit()), StringHash("减防持续时间")) <= 0.00 then
call SetUnitState(GetEnumUnit(), ConvertUnitState(0x20), GetUnitState(GetEnumUnit(), ConvertUnitState(0x20)) + LoadReal(AC, GetHandleId(GetEnumUnit()), StringHash("减防数值")))
call SaveReal(AC, GetHandleId(GetEnumUnit()), StringHash("减防持续时间"), 0.00)
call SaveReal(AC, GetHandleId(GetEnumUnit()), StringHash("减防数值"), 0.00)
call UnitRemoveAbility(GetEnumUnit(), 0x62666561)
call GroupRemoveUnit(ModNameSystem__buffdwz, GetEnumUnit())
endif
endif
endfunction
function BuffTimerSystem takes nothing returns nothing
if CountUnitsInGroup(ModNameSystem__buffdwz) > 0 then
call ForGroupBJ(ModNameSystem__buffdwz, function BuffGroupD)
endif
endfunction
function ModNameSystem_init takes nothing returns nothing
local timer t=CreateTimer()
set ModNameSystem__BuffSkillId[1]=SikllName(ModNameSystem__SkllJianFang)
set ModNameSystem__BuffSkillId[2]=SikllName(ModNameSystem__SkllJianSu)
set ModNameSystem__BuffSkillId[3]=SikllName(ModNameSystem__SkllJingGu)
set ModNameSystem__BuffSkillId[4]=SikllName(ModNameSystem__SkllJiYun)
set ModNameSystem__BuffMaJia[1]=ModName(ModNameSystem__BuffMaJiaName)
call TimerStart(t, 0.02, true, function BuffTimerSystem)
endfunction

//library ModNameSystem ends
//library NFTSSetUnitLoc:
function NFTSSetUnitLoc takes unit u,boolean b,unit m,real x,real y,real j,real s returns nothing
if b then
call SetUnitX(u, GetUnitX(m) + s * Cos(j * bj_DEGTORAD))
call SetUnitY(u, GetUnitY(m) + s * Sin(j * bj_DEGTORAD))
else
call SetUnitX(u, x + s * Cos(j * bj_DEGTORAD))
call SetUnitY(u, y + s * Sin(j * bj_DEGTORAD))
endif
endfunction

//library NFTSSetUnitLoc ends
//library QHJY:
function qhjyjs1 takes integer z1 returns integer
local integer array zheng
set zheng[1]=500
set zheng[2]=100
set zheng[3]=500
set zheng[11]=( ( ( z1 + 1 ) * zheng[2] ) + zheng[3] )
set zheng[12]=( ( ( ( ( ( z1 + 4 ) * zheng[2] ) + ( zheng[3] * 2 ) ) * ( z1 - 1 ) ) / 2 ) + zheng[1] )
return zheng[12]
endfunction
function qhjyjs takes unit d returns real
local real array shiz
set shiz[1]=I2R(GetHeroXP(d))
set shiz[2]=I2R(qhjyjs1(GetHeroLevel(d)))
set shiz[3]=I2R(qhjyjs1(( GetHeroLevel(d) - 1 )))
if ( ( shiz[3] <= 0.00 ) ) then
set shiz[3]=0.00
else
endif
set shiz[4]=( ( ( shiz[1] - shiz[3] ) / ( shiz[2] - shiz[3] + 0.0001 ) ) * 100.00 )
return shiz[4]
endfunction

//library QHJY ends
//library SJWEBase:
function SJWEBase__InitRect takes nothing returns nothing
call DestroyTimer(GetExpiredTimer())
set SJWEMinX=GetRectMinX(bj_mapInitialPlayableArea)
set SJWEMaxX=GetRectMaxX(bj_mapInitialPlayableArea)
set SJWEMinY=GetRectMinY(bj_mapInitialPlayableArea)
set SJWEMaxY=GetRectMaxY(bj_mapInitialPlayableArea)
endfunction
function CharAt takes string str,string l__SJWEBase__s returns integer
local integer i=0
local integer len=StringLength(l__SJWEBase__s)
loop
exitwhen i > StringLength(str) - len
if SubString(str, i, i + len) == l__SJWEBase__s then
return i
endif
set i=i + 1
endloop
return - 1
endfunction
function Hex_Str2I takes string l__SJWEBase__s returns integer
local integer i=0
local string S=""
local integer I=0
local integer d=StringLength(l__SJWEBase__s)
loop
set I=I + 1
set S=SubString(l__SJWEBase__s, I - 1, I)
if S == "A" then
set i=i + R2I(10 * Pow(16, d - I))
elseif S == "B" then
set i=i + R2I(11 * Pow(16, d - I))
elseif S == "C" then
set i=i + R2I(12 * Pow(16, d - I))
elseif S == "D" then
set i=i + R2I(13 * Pow(16, d - I))
elseif S == "E" then
set i=i + R2I(14 * Pow(16, d - I))
elseif S == "F" then
set i=i + R2I(15 * Pow(16, d - I))
else
set i=i + R2I(S2I(S) * Pow(16, d - I))
endif
exitwhen I == d
endloop
return i
endfunction
function I2Hex_Str takes integer i returns string
local integer ti=i
local integer I=0
local string l__SJWEBase__s=""
loop
set I=i - ( i / 16 ) * 16
if I < 10 then
set l__SJWEBase__s=I2S(I) + l__SJWEBase__s
elseif I == 10 then
set l__SJWEBase__s="A" + l__SJWEBase__s
elseif I == 11 then
set l__SJWEBase__s="B" + l__SJWEBase__s
elseif I == 12 then
set l__SJWEBase__s="C" + l__SJWEBase__s
elseif I == 13 then
set l__SJWEBase__s="D" + l__SJWEBase__s
elseif I == 14 then
set l__SJWEBase__s="E" + l__SJWEBase__s
elseif I == 15 then
set l__SJWEBase__s="F" + l__SJWEBase__s
endif
set i=i / 16
exitwhen i == 0
endloop
if ti == 0 then
set l__SJWEBase__s="00"
elseif ( ti <= 15 ) and ( ti > 0 ) then
set l__SJWEBase__s="0" + l__SJWEBase__s
endif
return l__SJWEBase__s
endfunction
function SetStringColor takes integer a,integer r,integer g,integer b,string l__SJWEBase__s returns string
set l__SJWEBase__s="|c" + I2Hex_Str(a) + I2Hex_Str(r) + I2Hex_Str(g) + I2Hex_Str(b) + l__SJWEBase__s + "|r"
return l__SJWEBase__s
endfunction
function InitIndex takes integer whichID returns nothing
call SaveInteger(SJWEBase__F, ( whichID ), 0, 1)
endfunction
function CreateIndex takes integer whichID returns integer
local integer i=( LoadInteger(SJWEBase__F, ( whichID ), 0) )
if ( LoadInteger(SJWEBase__P, ( whichID ), ( ( LoadInteger(SJWEBase__F, ( whichID ), 0) ) )) ) == 0 then
call SaveInteger(SJWEBase__F, ( whichID ), 0, ( ( LoadInteger(SJWEBase__F, ( whichID ), 0) ) + 1 ))
call SaveInteger(SJWEBase__F, ( whichID ), 1, LoadInteger(SJWEBase__F, ( whichID ), 0))
else
call SaveInteger(SJWEBase__F, ( whichID ), 0, ( - ( LoadInteger(SJWEBase__P, ( whichID ), ( ( LoadInteger(SJWEBase__F, ( whichID ), 0) ) )) ) ))
endif
call SaveBoolean(SJWEBase__P, ( whichID ), ( i ), ( true ))
return i
endfunction
function GetMaxIndex takes integer whichID returns integer
return LoadInteger(SJWEBase__F, ( whichID ), 1) - 1
endfunction
function DestroyIndex takes integer whichID,integer i returns nothing
if ( LoadBoolean(SJWEBase__P, ( whichID ), ( i )) ) == true then
call SaveInteger(SJWEBase__P, ( whichID ), ( i ), ( - ( LoadInteger(SJWEBase__F, ( whichID ), 0) ) ))
call SaveInteger(SJWEBase__F, ( whichID ), 0, ( i ))
endif
endfunction
function DestroyIndexAll takes integer whichID returns nothing
call FlushChildHashtable(SJWEBase__F, whichID)
call FlushChildHashtable(SJWEBase__P, whichID)
endfunction
function quick_sort takes integer left,integer right returns nothing
local integer i=left
local integer j=right
local real x=SJWEBase__s[( left + right ) / 2]
local real t=0
loop
loop
exitwhen x <= SJWEBase__s[i]
set i=i + 1
endloop
loop
exitwhen x >= SJWEBase__s[j]
set j=j - 1
endloop
if i <= j then
set t=SJWEBase__s[i]
set SJWEBase__s[i]=SJWEBase__s[j]
set SJWEBase__s[j]=t
set i=i + 1
set j=j - 1
endif
exitwhen i > j
endloop
if left < j then
call quick_sort(left , j)
endif
if i < right then
call quick_sort(i , right)
endif
endfunction
function SaveData takes integer index,real hartred returns nothing
set SJWEBase__s[index]=hartred
endfunction
function LoadData takes integer index returns real
return SJWEBase__s[index]
endfunction
function SpaceVectorRAD takes real x,real y,real z,real dist,real xRadians,real hRadians returns nothing
set SJWEBase__spaceVector_z=dist * Cos(hRadians)
set SJWEBase__spaceVector_x=x + SJWEBase__spaceVector_z * Cos(xRadians)
set SJWEBase__spaceVector_y=y + SJWEBase__spaceVector_z * Sin(xRadians)
set SJWEBase__spaceVector_z=z + dist * Sin(hRadians)
endfunction
function SpaceVectorDEG takes real x,real y,real z,real dist,real xDEG,real hDEG returns nothing
set xDEG=xDEG * bj_DEGTORAD
set hDEG=hDEG * bj_DEGTORAD
set SJWEBase__spaceVector_z=dist * Cos(hDEG)
set SJWEBase__spaceVector_x=x + SJWEBase__spaceVector_z * Cos(xDEG)
set SJWEBase__spaceVector_y=y + SJWEBase__spaceVector_z * Sin(xDEG)
set SJWEBase__spaceVector_z=z + dist * Sin(hDEG)
endfunction
function GetSpaceVector_x takes nothing returns real
return SJWEBase__spaceVector_x
endfunction
function GetSpaceVector_y takes nothing returns real
return SJWEBase__spaceVector_y
endfunction
function GetSpaceVector_z takes nothing returns real
return SJWEBase__spaceVector_z
endfunction
function Probability takes real a returns boolean
local boolean b=false
if ( a <= 0.00 ) then
set b=false
elseif ( ( a > 0.00 ) and ( a < 100.00 ) ) then
if ( GetRandomReal(0.00, 100.00) <= a ) then
set b=true
else
set b=false
endif
elseif ( a >= 100.0 ) then
set b=true
endif
return b
endfunction
function ReverseBoolean takes boolean b returns boolean
return not b
endfunction
function ItemSuperimpositionConditions takes nothing returns boolean
return ( ( GetItemType(GetManipulatedItem()) == ITEM_TYPE_CHARGED ) )
endfunction
function ItemSuperimpositionActions takes nothing returns nothing
local integer i
local unit U=GetTriggerUnit()
local item it=GetManipulatedItem()
set i=0
loop
exitwhen i > 5
if ( ( it != UnitItemInSlot(U, i) ) and ( GetItemTypeId(it) == GetItemTypeId(UnitItemInSlot(U, i)) ) ) then
call SetItemCharges(UnitItemInSlot(U, i), ( GetItemCharges(UnitItemInSlot(U, i)) + GetItemCharges(it) ))
call RemoveItem(it)
else
endif
set i=i + 1
endloop
set U=null
set it=null
endfunction
function ItemSuperimposition takes nothing returns nothing
local trigger tri=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tri, EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(tri, Condition(function ItemSuperimpositionConditions))
call TriggerAddAction(tri, function ItemSuperimpositionActions)
set tri=null
endfunction
function CreateMultiboardForPlayer takes player whichplayer,integer i returns multiboard
if i <= 0 then
set i=0
elseif i >= 680 then
set i=680
endif
if ( SJWEBase__lbn[S2I(I2S(GetPlayerId(whichplayer) + 1) + I2S(i))] == null ) then
set SJWEBase__lbn[S2I(I2S(GetPlayerId(whichplayer) + 1) + I2S(i))]=CreateMultiboard()
set bj_lastCreatedMultiboard=SJWEBase__lbn[S2I(I2S(GetPlayerId(whichplayer) + 1) + I2S(i))]
return SJWEBase__lbn[S2I(I2S(GetPlayerId(whichplayer) + 1) + I2S(i))]
else
return SJWEBase__lbn[S2I(I2S(GetPlayerId(whichplayer) + 1) + I2S(i))]
endif
endfunction
function DestroyMultiboardForPlayer takes player whichplayer,integer i returns nothing
if i <= 0 then
set i=0
elseif i >= 680 then
set i=680
endif
call DestroyMultiboard(SJWEBase__lbn[S2I(I2S(GetPlayerId(whichplayer) + 1) + I2S(i))])
set SJWEBase__lbn[S2I(I2S(GetPlayerId(whichplayer) + 1) + I2S(i))]=null
endfunction
function GetPlayerMultiboard takes player whichplayer,integer i returns multiboard
if i <= 0 then
set i=0
elseif i >= 680 then
set i=680
endif
return SJWEBase__lbn[S2I(I2S(GetPlayerId(whichplayer) + 1) + I2S(i))]
endfunction
function DisplayMultibosrdToPlayer takes player p,multiboard lb,boolean b returns nothing
if GetLocalPlayer() == p then
call MultiboardDisplay(lb, b)
endif
endfunction
function DisplayMultibosrdFoForce takes force f,multiboard lb,boolean b returns nothing
if IsPlayerInForce(GetLocalPlayer(), f) then
call MultiboardDisplay(lb, b)
endif
endfunction
function Print takes real timeout,string l__SJWEBase__s returns nothing
call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, timeout, l__SJWEBase__s)
endfunction
function DisplayDamage takes unit whichunit,string l__SJWEBase__s,real zOffset,real size,integer r,integer g,integer b,real transparency returns nothing
local texttag tt
set tt=CreateTextTag()
call SetTextTagText(tt, l__SJWEBase__s, size * ( 0.023 / 10 ))
call SetTextTagPos(tt, GetUnitX(whichunit), GetUnitY(whichunit), zOffset)
call SetTextTagColor(tt, r, g, b, PercentTo255(100.0 - transparency))
call SetTextTagVelocityBJ(tt, 100.00, GetRandomReal(80.00, 110.00))
call SetTextTagPermanent(tt, false)
call SetTextTagFadepoint(tt, 1.00)
call SetTextTagLifespan(tt, 2.00)
set tt=null
endfunction
function GetEnterUnit takes nothing returns unit
return LoadUnitHandle(DATA, GetHandleId(GetTriggeringTrigger()), StringHash("EnterUnit"))
endfunction
function TriggerRegisterAnyUnitEnterEvent takes trigger t returns nothing
set SJWEBase__TListEnd=SJWEBase__TListEnd + 1
set SJWEBase__TNextIndex[SJWEBase__TListEnd - 1]=SJWEBase__TListEnd
set SJWEBase__TLastIndex[SJWEBase__TListEnd]=SJWEBase__TListEnd - 1
set SJWEBase__TTriggerList[SJWEBase__TListEnd]=t
endfunction
function UnitEnterEventTriggerListExecute takes unit EnterUnit returns nothing
local integer index=0
set index=SJWEBase__TNextIndex[0]
loop
exitwhen ( index == 0 )
exitwhen ( index > SJWEBase__TListEnd )
if ( IsTriggerEnabled(SJWEBase__TTriggerList[index]) ) and ( TriggerEvaluate(SJWEBase__TTriggerList[index]) ) then
call SaveUnitHandle(DATA, GetHandleId(SJWEBase__TTriggerList[index]), StringHash("EnterUnit"), EnterUnit)
call TriggerExecute(SJWEBase__TTriggerList[index])
endif
set index=SJWEBase__TNextIndex[index]
endloop
endfunction
function DestroyAnyUnitEnterEvent takes trigger t returns nothing
local integer index=0
set index=SJWEBase__TNextIndex[0]
loop
exitwhen ( index == 0 )
exitwhen ( SJWEBase__TTriggerList[index] == t )
set index=SJWEBase__TNextIndex[index]
endloop
call FlushChildHashtable(DATA, GetHandleId(t))
if ( index > 0 ) then
set SJWEBase__TNextIndex[SJWEBase__TLastIndex[index]]=SJWEBase__TNextIndex[index]
set SJWEBase__TLastIndex[SJWEBase__TNextIndex[index]]=SJWEBase__TLastIndex[index]
endif
endfunction
function AnyUnitEnterRegionActionA takes nothing returns nothing
local group g=CreateGroup()
local unit pick
call GroupEnumUnitsInRect(g, bj_mapInitialPlayableArea, null)
loop
set pick=FirstOfGroup(g)
exitwhen ( pick == null )
call GroupRemoveUnit(g, pick)
call UnitEnterEventTriggerListExecute(pick)
endloop
call DestroyGroup(g)
set g=null
set pick=null
endfunction
function AnyUnitEnterRegionActionB takes nothing returns nothing
call UnitEnterEventTriggerListExecute(GetTriggerUnit())
endfunction
function AnyUnitEnterRegion takes nothing returns nothing
local region rectRegion=CreateRegion()
local trigger tr1=CreateTrigger()
local trigger tr2=CreateTrigger()
call TriggerRegisterTimerEvent(tr1, 0.0, false)
call TriggerAddAction(tr1, function AnyUnitEnterRegionActionA)
call RegionAddRect(rectRegion, bj_mapInitialPlayableArea)
call TriggerRegisterEnterRegion(tr2, rectRegion, null)
call TriggerAddAction(tr2, function AnyUnitEnterRegionActionB)
set tr1=null
set tr2=null
set rectRegion=null
endfunction
function InitializeSJWE takes nothing returns nothing
call TimerStart(CreateTimer(), 0, false, function SJWEBase__InitRect)
call AnyUnitEnterRegion()
endfunction

