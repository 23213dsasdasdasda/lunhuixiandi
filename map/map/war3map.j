function ZBTZ__YDWEIsEventPhysicalDamage takes nothing returns boolean
return 0 != EXGetEventDamageData(ZBTZ__EVENT_DAMAGE_DATA_IS_PHYSICAL)
endfunction
function ZBTZ__YDWEIsEventAttackDamage takes nothing returns boolean
return 0 != EXGetEventDamageData(ZBTZ__EVENT_DAMAGE_DATA_IS_ATTACK)
endfunction
function ZBTZ__YDWEIsEventRangedDamage takes nothing returns boolean
return 0 != EXGetEventDamageData(ZBTZ__EVENT_DAMAGE_DATA_IS_RANGED)
endfunction
function ZBTZ__YDWEIsEventDamageType takes damagetype damageType returns boolean
return damageType == ConvertDamageType(EXGetEventDamageData(ZBTZ__EVENT_DAMAGE_DATA_DAMAGE_TYPE))
endfunction
function ZBTZ__YDWEIsEventWeaponType takes weapontype weaponType returns boolean
return weaponType == ConvertWeaponType(EXGetEventDamageData(ZBTZ__EVENT_DAMAGE_DATA_WEAPON_TYPE))
endfunction
function ZBTZ__YDWEIsEventAttackType takes attacktype attackType returns boolean
return attackType == ConvertAttackType(EXGetEventDamageData(ZBTZ__EVENT_DAMAGE_DATA_ATTACK_TYPE))
endfunction
function ZBTZ__YDWESetEventDamage takes real amount returns boolean
return EXSetEventDamage(amount)
endfunction
