local group ydl_group
local unit ydl_unit
call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6C2DED4E, ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6C2DED4E) - 1 ))
call DisplayTimedTextToPlayer(ConvertedPlayer(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6F96F2D2)), 0, 0, 5.00, ( "[系统]：" + YDWEGetPlayerColorString(Player(2) , ( "雷劫即将到来：" + I2S(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6C2DED4E)) )) ))
if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6C2DED4E) == 0 ) ) then
set ydl_group=CreateGroup()
call GroupEnumUnitsInRange(ydl_group, udg_LGFZB_x[LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6F96F2D2)], udg_LGFZB_y[LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6F96F2D2)], 1000.00, null)
loop
set ydl_unit=FirstOfGroup(ydl_group)
exitwhen ydl_unit == null
call GroupRemoveUnit(ydl_group, ydl_unit)
if ( ( ydl_unit == udg_WJYX[LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6F96F2D2)] ) ) then
call UnitDamageTargetBJ(gg_unit_Hamg_0014, ydl_unit, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6DD3A3AB), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
if ( ( IsUnitAliveBJ(ydl_unit) == true ) ) then
call DestroyEffect(AddSpecialEffectTarget("E\\[e] (14).mdl", ydl_unit, "origin"))
call YDWETimerDestroyEffect(0.50 , AddSpecialEffectTarget("G\\[g] (25).mdl", udg_WJYX[LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6F96F2D2)], "chest"))
