function InitTrig________jn takes nothing returns nothing
set gg_trg________jn=CreateTrigger()
call TriggerAddAction(gg_trg________jn, function Trig________jnActions)
endfunction
function Trig_jinshouzhiConditions takes nothing returns boolean
return ( ( ( (LoadInteger(YDHT, StringHash((GetPlayerName(GetTriggerPlayer()) )), StringHash(( "1")))) == 1 ) or ( (LoadInteger(YDHT, StringHash((GetPlayerName(GetTriggerPlayer()) )), StringHash(( "2")))) == 1 ) ) ) // INLINED!!
endfunction
function Trig_jinshouzhiActions takes nothing returns nothing
local integer ydl_localvar_step=LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
set ydl_localvar_step=ydl_localvar_step + 3
call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
