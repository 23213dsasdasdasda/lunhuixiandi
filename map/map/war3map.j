function Trig_TSDJActions takes nothing returns nothing
local timer ydl_timer
local integer ydl_triggerstep
local trigger ydl_trigger
local integer ydl_localvar_step=LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
set ydl_localvar_step=ydl_localvar_step + 3
call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
if ( ( GetOwningPlayer(GetTriggerUnit()) == GetLocalPlayer() ) ) then
call DzFrameSetText(udg_ui_sjtz[5], ( ( ( YDWEGetPlayerColorString(Player(4) , "等级：") + I2S(GetHeroLevel(GetTriggerUnit())) ) ) + ( "" ) + ( "" ) ))
else
endif
if ( ( GetHeroLevel(GetTriggerUnit()) == ( LoadInteger(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0x861E1815) * 10 ) ) ) then
call SuspendHeroXPBJ(false, GetTriggerUnit())
if ( ( GetOwningPlayer(GetTriggerUnit()) == GetLocalPlayer() ) ) then
call DzFrameSetTexture(udg_ui_sjtz[4], "war3mapImported\\ui_tp (1).tga", 0)
call DzFrameShow(udg_ui_sjtz[7], true)
else
endif
set ydl_timer=CreateTimer()
call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
call TimerStart(ydl_timer, 0.03, false, function Trig_TSDJFunc004Func004T)
else
endif
if ( ( GetHeroLevel(GetTriggerUnit()) == 50 ) ) then
call AddPlayerTechResearched(GetOwningPlayer(GetTriggerUnit()), 0x66797979, 1)
call SelectUnitForPlayerSingle(GetTriggerUnit(), GetOwningPlayer(GetTriggerUnit()))
else
endif
if ( ( GetHeroLevel(GetTriggerUnit()) == 35 ) ) then
call SavePlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x48656946, GetOwningPlayer(GetTriggerUnit()))
