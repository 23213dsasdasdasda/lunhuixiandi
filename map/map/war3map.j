function JK_Timer01 takes timer TIM,real S,boolean BL,code T,string STR returns nothing
local integer A
local timerdialog TD
set TIM=CreateTimer()
set TD=CreateTimerDialog(TIM)
call TimerStart(TIM, S, BL, T)
set A=GetHandleId(TIM)
call SaveTimerDialogHandle(JK_HT, A, 0, TD)
call TimerDialogSetTitle(TD, STR)
call TimerDialogDisplay(TD, true)
if ( BL == false ) then
call JK_Timer02()
endif
set TIM=null
set TD=null
endfunction
function JK_TextTag takes real X1,real Y1,real Z1,boolean BL,string STR,real SIZE,real X2,real Y2,real S1,real S2 returns nothing
local texttag NEW=CreateTextTag()
call SetTextTagPos(NEW, X1, Y1, Z1)
call SetTextTagPermanent(NEW, BL)
call SetTextTagVisibility(NEW, true)
call SetTextTagText(NEW, STR, SIZE)
call SetTextTagVelocity(NEW, X2, Y2)
call SetTextTagFadepoint(NEW, S1)
call SetTextTagLifespan(NEW, S2)
set NEW=null
endfunction
function JK_SectorCoordinates takes real Xr,real Yr,real X,real Y,real R,real D1,real D2 returns boolean
local real DIS=SquareRoot(Pow(( Xr - X ), 2.00) + Pow(( Yr - Y ), 2.00))
local real Djud=Atan(( Yr - Y ) / ( Xr - X ))
if ( R <= DIS ) then
if ( D1 < 0.00 ) then
loop
set D1=D1 + 360.00
exitwhen D1 > 0.00
endloop
endif
if ( D2 < 0.00 ) then
loop
set D2=D2 + 360.00
exitwhen D2 > 0.00
endloop
endif
if ( D1 < D2 ) and ( Djud >= D1 ) and ( Djud <= D2 ) then
return true
elseif ( D1 > D2 ) and ( Djud <= D1 ) and ( Djud >= D2 ) then
return true
else
return false
endif
else
return false
endif
endfunction
function JK_SectorGroup takes real X,real Y,real R,real D1,real D2,boolexpr filter returns group
local group G=CreateGroup()
local unit U
local real DIS
local real Djud
call GroupEnumUnitsInRange(G, X, Y, R, filter)
loop
set U=FirstOfGroup(G)
exitwhen U == null
if ( JK_SectorCoordinates(GetUnitX(U) , GetUnitY(U) , X , Y , R , D1 , D2) == true ) then
else
call GroupRemoveUnit(G, U)
endif
endloop
set U=null
return G
endfunction
function JK_ClearTextMessages takes player PL returns nothing
if ( PL == GetLocalPlayer() ) then
call ClearTextMessages()
endif
endfunction
function JK_ClearTextMessagesA takes player PL,string TEXTS,real T returns nothing
if ( PL == GetLocalPlayer() ) then
call ClearTextMessages()
endif
call DisplayTimedTextToPlayer(PL, 0, 0, T, TEXTS)
endfunction
function JK_RestrainTimer takes nothing returns nothing
local timer T=GetExpiredTimer()
local integer Index=GetHandleId(T)
local unit U=LoadUnitHandle(JK_HT, Index, 0)
local effect EF=LoadEffectHandle(JK_HT, Index, 1)
call PauseUnit(U, false)
call FlushChildHashtable(JK_HT, Index)
call DestroyEffect(EF)
call DestroyTimer(T)
set T=null
set U=null
set EF=null
endfunction
function JK_Restrain takes unit U,real SJ,effect EF returns nothing
local timer T=CreateTimer()
local integer Index=GetHandleId(T)
call PauseUnit(U, true)
call SaveUnitHandle(JK_HT, Index, 0, U)
call SaveEffectHandle(JK_HT, Index, 1, EF)
call TimerStart(T, SJ, false, function JK_RestrainTimer)
set T=null
endfunction
function JK_SX_Change takes unit U,unitstate WUS,integer Model,real Value returns nothing
local real X=GetUnitState(U, WUS)
if ( Model == 1 ) then
set X=X + Value
elseif ( Model == 2 ) then
set X=X - Value
elseif ( Model == 3 ) then
set X=X * Value
elseif ( Model == 4 ) then
set X=X / Value
endif
call SetUnitState(U, WUS, X)
endfunction

