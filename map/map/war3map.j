function XG_UnitGetBonus takes unit u,integer bonusType returns integer
return LoadInteger(XGGeneralBonusSystem__htb, GetHandleId(u), bonusType)
endfunction
function XGGeneralBonusSystem__SetUnitState takes unit u,integer x,integer n returns boolean
local integer num=n
local integer v=0
local integer aid
local unitstate state
local integer i=1
if x == 1 then
set state=UNIT_STATE_MAX_LIFE
call SaveInteger(XGGeneralBonusSystem__htb, GetHandleId(u), StringHash("生命值2"), LoadInteger(XGGeneralBonusSystem__htb, GetHandleId(u), StringHash("生命值2")) + n)
elseif x == 2 then
set state=UNIT_STATE_MAX_MANA
call SaveInteger(XGGeneralBonusSystem__htb, GetHandleId(u), StringHash("魔法值2"), LoadInteger(XGGeneralBonusSystem__htb, GetHandleId(u), StringHash("生命值2")) + n)
else
return false
endif
if num > 0 then
set v=3
elseif num < 0 then
set v=2
set num=- num
else
return false
endif
loop
if num == 0 then
call SaveInteger(XGGeneralBonusSystem__htb, GetHandleId(u), x, num)
if n == 0 then
call SaveBoolean(XGGeneralBonusSystem__htb, GetHandleId(u), 0, false)
endif
exitwhen true
elseif num > 0 then
set aid=XGGeneralBonusSystem__ABILITY_COUNT[x] + 1 - i
if num < XGGeneralBonusSystem__PowersOf2[aid] then
set i=i + 1
else
set num=num - XGGeneralBonusSystem__PowersOf2[aid]
set aid=XGGeneralBonusSystem__BonusAbilitys[aid]
call UnitAddAbility(u, aid)
call SetUnitAbilityLevel(u, aid, v)
call UnitRemoveAbility(u, aid)
endif
else
set aid=XGGeneralBonusSystem__ABILITY_COUNT[x] + 1 - i
if - num < XGGeneralBonusSystem__PowersOf2[aid] then
set i=i + 1
else
set num=num + XGGeneralBonusSystem__PowersOf2[aid]
set aid=XGGeneralBonusSystem__BonusAbilitys[aid]
call UnitAddAbility(u, aid)
call SetUnitAbilityLevel(u, aid, v)
call UnitRemoveAbility(u, aid)
endif
endif
endloop
return true
endfunction
function XGGeneralBonusSystem__UnitClearBonus takes unit u,integer y returns nothing
local integer i=XGGeneralBonusSystem__ABILITY_COUNT[y]
loop
exitwhen i <= XGGeneralBonusSystem__ABILITY_COUNT[y - 1]
call UnitRemoveAbility(u, XGGeneralBonusSystem__BonusAbilitys[i])
set i=i - 1
endloop
call SaveInteger(XGGeneralBonusSystem__htb, GetHandleId(u), y, 0)
call SaveBoolean(XGGeneralBonusSystem__htb, GetHandleId(u), 0, false)
endfunction
function XG_UnitSetBonus takes unit u,integer bonusType,integer mod,integer ammount returns boolean
local integer i
if bonusType > 10 or bonusType < 1 then
return false
endif
if mod == 0 then
if bonusType == 1 or bonusType == 2 then
if bonusType == 1 then
set ammount=LoadInteger(XGGeneralBonusSystem__htb, GetHandleId(u), StringHash("生命值2"))
else
set ammount=LoadInteger(XGGeneralBonusSystem__htb, GetHandleId(u), StringHash("魔法值2"))
endif
return XGGeneralBonusSystem__SetUnitState(u , bonusType , - ammount)
else
call SaveInteger(XGGeneralBonusSystem__htb, GetHandleId(u), bonusType, ammount)
endif
elseif mod == - 1 then
call SaveInteger(XGGeneralBonusSystem__htb, GetHandleId(u), bonusType, LoadInteger(XGGeneralBonusSystem__htb, GetHandleId(u), bonusType) - ammount)
else
call SaveInteger(XGGeneralBonusSystem__htb, GetHandleId(u), bonusType, LoadInteger(XGGeneralBonusSystem__htb, GetHandleId(u), bonusType) + ammount)
endif
set ammount=LoadInteger(XGGeneralBonusSystem__htb, GetHandleId(u), bonusType)
if bonusType == 1 or bonusType == 2 then
return XGGeneralBonusSystem__SetUnitState(u , bonusType , ammount)
endif
if ammount == 0 then
call XGGeneralBonusSystem__UnitClearBonus(u , bonusType)
return false
endif
if ammount < XGGeneralBonusSystem__MinBonus[bonusType] or ammount > XGGeneralBonusSystem__MaxBonus[bonusType] then
return false
endif
if ammount < 0 then
set ammount=XGGeneralBonusSystem__MaxBonus[bonusType] + ammount + 1
call UnitAddAbility(u, XGGeneralBonusSystem__BonusAbilitys[XGGeneralBonusSystem__ABILITY_COUNT[bonusType]])
call UnitMakeAbilityPermanent(u, true, XGGeneralBonusSystem__BonusAbilitys[XGGeneralBonusSystem__ABILITY_COUNT[bonusType]])
else
call UnitRemoveAbility(u, XGGeneralBonusSystem__BonusAbilitys[XGGeneralBonusSystem__ABILITY_COUNT[bonusType]])
endif
set i=XGGeneralBonusSystem__ABILITY_COUNT[bonusType] - 1
loop
exitwhen i <= XGGeneralBonusSystem__ABILITY_COUNT[bonusType - 1]
if ammount >= XGGeneralBonusSystem__PowersOf2[i] then
call UnitAddAbility(u, XGGeneralBonusSystem__BonusAbilitys[i])
call UnitMakeAbilityPermanent(u, true, XGGeneralBonusSystem__BonusAbilitys[i])
set ammount=ammount - XGGeneralBonusSystem__PowersOf2[i]
else
call UnitRemoveAbility(u, XGGeneralBonusSystem__BonusAbilitys[i])
endif
set i=i - 1
endloop
if not LoadBoolean(XGGeneralBonusSystem__htb, GetHandleId(u), 0) then
call SaveBoolean(XGGeneralBonusSystem__htb, GetHandleId(u), 0, true)
endif
return true
endfunction
function XGGeneralBonusSystem__Initialize takes nothing returns nothing
local integer i=1
local unit u
local integer n=1
local integer add=1
local integer array c
local integer max=31
loop
set c[i]=0x30 - 1 + i
set i=i + 1
exitwhen i > 10
endloop
set i=1
loop
set c[i + 10]=0x61 - 1 + i
set i=i + 1
exitwhen i > 26
endloop
set XGGeneralBonusSystem__ABILITY_NUM[1]=max
set XGGeneralBonusSystem__ABILITY_NUM[2]=max
set XGGeneralBonusSystem__ABILITY_NUM[3]=max
set XGGeneralBonusSystem__ABILITY_NUM[4]=max
set XGGeneralBonusSystem__ABILITY_NUM[5]=max
set XGGeneralBonusSystem__ABILITY_NUM[6]=max
set XGGeneralBonusSystem__ABILITY_NUM[7]=12
set XGGeneralBonusSystem__ABILITY_NUM[8]=max
set XGGeneralBonusSystem__ABILITY_NUM[9]=max
set XGGeneralBonusSystem__ABILITY_NUM[10]=max
set XGGeneralBonusSystem__ABILITY_COUNT[0]=0
set XGGeneralBonusSystem__ABILITY_COUNT[1]=max
set XGGeneralBonusSystem__ABILITY_COUNT[2]=max * 2
set XGGeneralBonusSystem__ABILITY_COUNT[3]=max * 3
set XGGeneralBonusSystem__ABILITY_COUNT[4]=max * 4
set XGGeneralBonusSystem__ABILITY_COUNT[5]=max * 5
set XGGeneralBonusSystem__ABILITY_COUNT[6]=max * 6
set XGGeneralBonusSystem__ABILITY_COUNT[7]=max * 6 + 12
set XGGeneralBonusSystem__ABILITY_COUNT[8]=XGGeneralBonusSystem__ABILITY_COUNT[7] + XGGeneralBonusSystem__ABILITY_NUM[8]
set XGGeneralBonusSystem__ABILITY_COUNT[9]=XGGeneralBonusSystem__ABILITY_COUNT[8] + XGGeneralBonusSystem__ABILITY_NUM[9]
set XGGeneralBonusSystem__ABILITY_COUNT[10]=XGGeneralBonusSystem__ABILITY_COUNT[9] + XGGeneralBonusSystem__ABILITY_NUM[10]
set i=1
loop
set XGGeneralBonusSystem__BonusAbilitys[i + max * 0]=0x58476130 - 0x30 + c[i]
set XGGeneralBonusSystem__BonusAbilitys[i + max * 1]=0x58476230 - 0x30 + c[i]
set XGGeneralBonusSystem__BonusAbilitys[i + max * 2]=0x58476430 - 0x30 + c[i]
set XGGeneralBonusSystem__BonusAbilitys[i + max * 3]=0x58476330 - 0x30 + c[i]
set XGGeneralBonusSystem__BonusAbilitys[i + max * 4]=0x58476630 - 0x30 + c[i]
set XGGeneralBonusSystem__BonusAbilitys[i + max * 5]=0x58476730 - 0x30 + c[i]
set XGGeneralBonusSystem__BonusAbilitys[i + XGGeneralBonusSystem__ABILITY_COUNT[7]]=0x58476830 - 0x30 + c[i]
set XGGeneralBonusSystem__BonusAbilitys[i + XGGeneralBonusSystem__ABILITY_COUNT[8]]=0x58476930 - 0x30 + c[i]
set XGGeneralBonusSystem__BonusAbilitys[i + XGGeneralBonusSystem__ABILITY_COUNT[9]]=0x58476A30 - 0x30 + c[i]
set i=i + 1
exitwhen i > max
endloop
set i=1
loop
set XGGeneralBonusSystem__BonusAbilitys[i + max * 6 + 12 * 0]=0x58476530 - 0x30 + c[i]
set i=i + 1
exitwhen i > 12
endloop
loop
set i=1
set XGGeneralBonusSystem__PowersOf2[add]=1
loop
set XGGeneralBonusSystem__PowersOf2[add + 1]=XGGeneralBonusSystem__PowersOf2[add] * 2
set add=add + 1
set i=i + 1
exitwhen i >= XGGeneralBonusSystem__ABILITY_NUM[n]
endloop
set XGGeneralBonusSystem__MaxBonus[n]=XGGeneralBonusSystem__PowersOf2[add] - 1
set XGGeneralBonusSystem__MinBonus[n]=- XGGeneralBonusSystem__PowersOf2[add]
set add=add + 1
set n=n + 1
exitwhen n > 10
endloop
set u=CreateUnit(Player(15), 0x68706561, 0, 0, 0)
set i=0
loop
exitwhen i == XGGeneralBonusSystem__ABILITY_COUNT[7]
call UnitAddAbility(u, XGGeneralBonusSystem__BonusAbilitys[i])
set i=i + 1
endloop
call RemoveUnit(u)
set u=null
endfunction

