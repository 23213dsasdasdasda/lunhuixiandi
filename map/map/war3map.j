//library Func ends
//library JYDamage:
function JYCallUnitTrigger takes nothing returns boolean
local integer i=0
loop
exitwhen i >= JYDamage__JYDamageNum
if JYDamage__TriggerEventArray[i] != null and IsTriggerEnabled(JYDamage__TriggerEventArray[i]) and TriggerEvaluate(JYDamage__TriggerEventArray[i]) then
call TriggerExecute(JYDamage__TriggerEventArray[i])
endif
set i=i + 1
endloop
return true
endfunction
function JYDamageCondition takes nothing returns boolean
local unit u=GetFilterUnit()
local trigger t
if GetUnitAbilityLevel(u, 0x416C6F63) <= 0 then
call GroupAddUnit(JYDamage__JYDamageGroup, u)
call SaveTriggerHandle(JYDamage__DamageHt, GetHandleId(u), 0x74726967, CreateTrigger())
set t=LoadTriggerHandle(JYDamage__DamageHt, GetHandleId(u), 0x74726967)
call TriggerRegisterUnitEvent(t, u, EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t, Condition(function JYCallUnitTrigger))
endif
set u=null
set t=null
return false
endfunction
function JYClearTrigger takes nothing returns nothing
call DestroyTrigger(LoadTriggerHandle(JYDamage__DamageHt, GetHandleId(GetDyingUnit()), 0x74726967))
endfunction
function JYRegisterUnit takes nothing returns nothing
local trigger t=CreateTrigger()
local trigger t1=CreateTrigger()
local region r=CreateRegion()
call RegionAddRect(r, GetWorldBounds())
call TriggerRegisterEnterRegion(t, r, Condition(function JYDamageCondition))
call GroupEnumUnitsInRect(JYDamage__JYDamageGroup, GetWorldBounds(), Condition(function JYDamageCondition))
call TriggerRegisterAnyUnitEventBJ(t1, EVENT_PLAYER_UNIT_DEATH)
call TriggerAddAction(t1, function JYClearTrigger)
set r=null
set t=null
set t1=null
endfunction
function JYDamageEvent takes trigger trg returns nothing
if trg == null then
return
endif
if JYDamage__JYDamageNum == 0 then
call JYRegisterUnit()
endif
set JYDamage__TriggerEventArray[JYDamage__JYDamageNum]=trg
set JYDamage__JYDamageNum=JYDamage__JYDamageNum + 1
endfunction

