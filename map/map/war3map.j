return LoadReal(ZBTZ__TZHT, GetHandleId(dw), mod)
endfunction
function XY_unitCallCustomSxB takes unit dw,integer mod returns real
return LoadReal(ZBTZ__TZHT, GetHandleId(dw), mod)
endfunction
function XY_UnitStantTypeInt takes boolean t returns nothing
call SaveBoolean(ZBTZ__TZHT, StringHash("加成方式"), 1, t)
endfunction
function UnitStantGJSX takes unit dw,integer i returns nothing
local integer sxz=R2I(LoadReal(ZBTZ__TZHT, GetHandleId(dw), i))
local real rsx=LoadReal(ZBTZ__TZHT, GetHandleId(dw), i)
if LoadBoolean(ZBTZ__TZHT, StringHash("加成方式"), 1) then
if LoadInteger(ZBTZ__TZHT, i, StringHash("绑定属性")) == 11 then
call SetHeroStr(dw, GetHeroStr(dw, false) + sxz, false)
call SetHeroAgi(dw, GetHeroAgi(dw, false) + sxz, false)
call SetHeroInt(dw, GetHeroInt(dw, false) + sxz, false)
elseif LoadInteger(ZBTZ__TZHT, i, StringHash("绑定属性")) < 11 then
if LoadInteger(ZBTZ__TZHT, i, StringHash("绑定属性")) == 3 then
call SetUnitState(dw, ConvertUnitState(0x12), ( GetUnitState(dw, ConvertUnitState(0x12)) + rsx ))
elseif LoadInteger(ZBTZ__TZHT, i, StringHash("绑定属性")) == 4 then
call SetUnitState(dw, ConvertUnitState(0x20), ( GetUnitState(dw, ConvertUnitState(0x20)) + rsx ))
elseif LoadInteger(ZBTZ__TZHT, i, StringHash("绑定属性")) == 1 then
call SetUnitState(dw, UNIT_STATE_MAX_LIFE, ( GetUnitState(dw, UNIT_STATE_MAX_LIFE) + rsx ))
elseif LoadInteger(ZBTZ__TZHT, i, StringHash("绑定属性")) == 8 then
call SetHeroStr(dw, GetHeroStr(dw, false) + sxz, false)
elseif LoadInteger(ZBTZ__TZHT, i, StringHash("绑定属性")) == 9 then
call SetHeroAgi(dw, GetHeroAgi(dw, false) + sxz, false)
elseif LoadInteger(ZBTZ__TZHT, i, StringHash("绑定属性")) == 10 then
call SetHeroInt(dw, GetHeroInt(dw, false) + sxz, false)
endif
endif
else
if LoadInteger(ZBTZ__TZHT, i, StringHash("绑定属性")) == 11 then
call XG_UnitSetBonus(dw , 8 , 1 , R2I(LoadReal(ZBTZ__TZHT, GetHandleId(dw), i)))
call XG_UnitSetBonus(dw , 9 , 1 , R2I(LoadReal(ZBTZ__TZHT, GetHandleId(dw), i)))
call XG_UnitSetBonus(dw , 10 , 1 , R2I(LoadReal(ZBTZ__TZHT, GetHandleId(dw), i)))
elseif LoadInteger(ZBTZ__TZHT, i, StringHash("绑定属性")) < 11 then
call XG_UnitSetBonus(dw , LoadInteger(ZBTZ__TZHT, i, StringHash("绑定属性")) , 1 , R2I(LoadReal(ZBTZ__TZHT, GetHandleId(dw), i)))
endif
endif
endfunction
function XY_UnitSetBonus_WB takes unit u,integer bonusType,integer mod,integer ammount returns nothing
local real hp=GetUnitLifePercent(u)
if LoadBoolean(ZBTZ__TZHT, StringHash("加成方式"), 1) then
if bonusType == 1 then
call SetUnitState(u, UNIT_STATE_MAX_LIFE, ( GetUnitState(u, UNIT_STATE_MAX_LIFE) + I2R(ammount * mod) ))
elseif bonusType == 2 then
call SetUnitState(u, UNIT_STATE_MAX_MANA, ( GetUnitState(u, UNIT_STATE_MAX_MANA) + I2R(ammount * mod) ))
elseif bonusType == 3 then
call SetUnitState(u, ConvertUnitState(0x12), ( GetUnitState(u, ConvertUnitState(0x12)) + I2R(ammount * mod) ))
elseif bonusType == 4 then
call SetUnitState(u, ConvertUnitState(0x20), ( GetUnitState(u, ConvertUnitState(0x20)) + I2R(ammount * mod) ))
elseif bonusType == 5 or bonusType == 6 then
call XG_UnitSetBonus(u , bonusType , mod , ammount)
elseif bonusType == 7 then
call SetUnitState(u, ConvertUnitState(0x51), ( GetUnitState(u, ConvertUnitState(0x51)) + I2R(ammount * mod) * 0.01 ))
elseif bonusType == 8 then
call SetHeroStr(u, GetHeroStr(u, false) + ammount * mod, false)
elseif bonusType == 9 then
call SetHeroAgi(u, GetHeroAgi(u, false) + ammount * mod, false)
elseif bonusType == 10 then
call SetHeroInt(u, GetHeroInt(u, false) + ammount * mod, false)
endif
call SetUnitLifePercentBJ(u, hp)
else
call XG_UnitSetBonus(u , bonusType , mod , ammount)
endif
endfunction
function TextTagSpeed2VelocityA takes real speed returns real
return speed * 0.071 / 128
endfunction
function XYSetTextTagVelocityBJ takes texttag tt,real speed,real angle returns nothing
local real vel=(((speed)*1.0) * 0.071 / 128) // INLINED!!
local real xvel=vel * Cos(angle * bj_DEGTORAD)
local real yvel=vel * Sin(angle * bj_DEGTORAD)
call SetTextTagVelocity(tt, xvel, yvel)
endfunction
function XYTextTagSize2Height takes real size returns real
return size * 0.023 / 10
endfunction
function XYSetTextTagTextBJ takes texttag tt,string s,real size returns nothing
local real textHeight=(((size)*1.0) * 0.023 / 10) // INLINED!!
call SetTextTagText(tt, s, textHeight)
endfunction
function TXSC_on takes nothing returns nothing
local timer t=GetExpiredTimer()
call DestroyEffect(LoadEffectHandle(ZBTZ__TZHT, GetHandleId(t), 1))
call FlushChildHashtable(ZBTZ__TZHT, GetHandleId(t))
call DestroyTimer(t)
set t=null
endfunction
function TXSC takes effect tx,real sj returns nothing
local timer t=CreateTimer()
call TimerStart(t, sj, false, function TXSC_on)
call SaveEffectHandle(ZBTZ__TZHT, GetHandleId(t), 1, tx)
set t=null
endfunction
function modfontZt takes unit dw,string qb,string wb,boolean shtype returns nothing
local integer i=1
local integer xh
local real x=GetUnitX(dw)
local real y=GetUnitY(dw)
local string zfc
local integer wbcd=StringLength(wb)
if qb == "物暴" then
call TXSC(AddSpecialEffect(ZBTZ__WLSHZT[10], x - 80, y + 50) , 1.00)
elseif qb == "法暴" then
call TXSC(AddSpecialEffect(ZBTZ__FSSHZT[10], x - 80, y + 50) , 1.00)
endif
loop
exitwhen i > wbcd
set zfc=SubStringBJ(wb, i, i)
if ZBTZ__SHWZindent > 0 then
if wbcd >= 4 + ZBTZ__SHWZindent and i > wbcd - 4 then
if shtype == false then
call TXSC(AddSpecialEffect(ZBTZ__WLSHZT[11], x + 33 * I2R(i) - 50, y + 50) , 1.00)
else
call TXSC(AddSpecialEffect(ZBTZ__FSSHZT[11], x + 33 * I2R(i) - 50, y + 50) , 1.00)
endif
set i=wbcd + 1
else
if shtype == false then
call TXSC(AddSpecialEffect(ZBTZ__WLSHZT[S2I(zfc)], x + 33 * I2R(i) - 50, y + 50) , 1.00)
else
call TXSC(AddSpecialEffect(ZBTZ__FSSHZT[S2I(zfc)], x + 33 * I2R(i) - 50, y + 50) , 1.00)
endif
endif
else
if shtype == false then
call TXSC(AddSpecialEffect(ZBTZ__WLSHZT[S2I(zfc)], x + 33 * I2R(i) - 50, y + 50) , 1.00)
else
call TXSC(AddSpecialEffect(ZBTZ__FSSHZT[S2I(zfc)], x + 33 * I2R(i) - 50, y + 50) , 1.00)
endif
endif
set i=i + 1
endloop
endfunction
function MianyiSH takes unit dw returns nothing
local integer xh
local real x=GetUnitX(dw)
local real y=GetUnitY(dw)
local string zfc
call TXSC(AddSpecialEffect(ZBTZ__WLSHZT[13], x, y) , 1.00)
endfunction
function PFWZDZ takes nothing returns nothing
local timer t=GetExpiredTimer()
local texttag pf=LoadTextTagHandle(ZBTZ__TZHT, GetHandleId(t), StringHash("漂浮"))
local string wb=LoadStr(ZBTZ__TZHT, GetHandleId(t), StringHash("内容"))
call SaveInteger(ZBTZ__TZHT, GetHandleId(t), GetHandleId(pf), LoadInteger(ZBTZ__TZHT, GetHandleId(t), GetHandleId(pf)) + 1)
if ( LoadInteger(ZBTZ__TZHT, GetHandleId(t), GetHandleId(pf)) <= 6 ) then
call XYSetTextTagTextBJ(pf , wb , 11.00 + I2R(LoadInteger(ZBTZ__TZHT, GetHandleId(t), GetHandleId(pf)) * 2))
else
call XYSetTextTagTextBJ(pf , wb , 31.00 - I2R(LoadInteger(ZBTZ__TZHT, GetHandleId(t), GetHandleId(pf)) * 2))
endif
if ( LoadInteger(ZBTZ__TZHT, GetHandleId(t), GetHandleId(pf)) >= 15 ) then
call FlushChildHashtable(ZBTZ__TZHT, GetHandleId(t))
call DestroyTextTag(pf)
call DestroyTimer(t)
endif
set t=null
set pf=null
set wb=null
endfunction
function PFZQ takes nothing returns nothing
local timer t=GetExpiredTimer()
call SaveBoolean(ZBTZ__TZHT, StringHash("伤害文字周期T"), LoadInteger(ZBTZ__TZHT, GetHandleId(t), 1), true)
call FlushChildHashtable(ZBTZ__TZHT, GetHandleId(t))
call DestroyTimer(t)
set t=null
endfunction
function PFWZ takes unit dw,unit dw2,string qb,string wb,real hong,real lv,real lan,boolean shtype returns nothing
local integer sy=GetPlayerId(GetOwningPlayer(dw))
local timer t=null
if ZBTZ__SHXS[sy] then
if ZBTZ__SHXSZQB[sy] + ZBTZ__SHXSZQ[sy] <= I2R(ZBTZ__QJSJ) then
set ZBTZ__SHXSZQB[sy]=ZBTZ__QJSJ
if ZBTZ__SHXSZT[sy] then
if qb == "免疫" then
call MianyiSH(dw)
else
call modfontZt(dw2 , qb , wb , shtype)
endif
endif
endif
endif
set t=null
endfunction
function ZLPFWZ takes unit dw,unit dw2,string qb,string wb,real hong,real lv,real lan,boolean shtype returns nothing
local timer t=null
local integer sy=GetPlayerId(GetOwningPlayer(dw))
if ZBTZ__SHXS[sy] == true then
if ZBTZ__SHWZindent > 0 and StringLength(wb) >= 4 + ZBTZ__SHWZindent then
set wb=SubStringBJ(wb, 1, StringLength(wb) - 4) + "万"
endif
set t=CreateTimer()
call CreateTextTagUnitBJ(wb, dw2, - 75.00, 10.00, hong, lv, lan, 0)
call SetTextTagFadepoint(GetLastCreatedTextTag(), 0.00)
call XYSetTextTagVelocityBJ(GetLastCreatedTextTag() , 150.00 , 90.00)
call SetTextTagPermanent(GetLastCreatedTextTag(), false)
call SaveTextTagHandle(ZBTZ__TZHT, GetHandleId(t), StringHash("漂浮"), GetLastCreatedTextTag())
call SaveStr(ZBTZ__TZHT, GetHandleId(t), StringHash("内容"), wb)
call TimerStart(t, 0.05, true, function PFWZDZ)
endif
set t=null
endfunction
function XY_PFWZkey takes player wj,boolean t,real xscycle,boolean modfont returns nothing
set ZBTZ__SHXS[GetPlayerId(wj)]=t
set ZBTZ__SHXSZQ[GetPlayerId(wj)]=xscycle
set ZBTZ__SHXSZT[GetPlayerId(wj)]=modfont
set ZBTZ__SHXSZQB[GetPlayerId(wj)]=ZBTZ__QJSJ
endfunction
function XY_PFWZindent takes integer ws returns nothing
set ZBTZ__SHWZindent=ws
endfunction
function FL takes unit dw,unit dw2,real shz returns nothing
local group g=CreateGroup()
local unit u
call GroupEnumUnitsInRange(g, GetUnitX(dw2), GetUnitY(dw2), 350, null)
loop
set u=FirstOfGroup(g)
exitwhen u == null
call GroupRemoveUnit(g, u)
if ( IsUnitType(u, UNIT_TYPE_STRUCTURE) == false ) and ( u != dw2 ) and ( IsUnitAliveBJ(u) == true ) and ( IsUnitEnemy(u, GetOwningPlayer(dw)) == true ) then
call UnitDamageTarget(dw, u, shz, false, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
endif
endloop
call DestroyGroup(g)
set u=null
set dw=null
set dw2=null
endfunction
function TXSH takes unit dw,unit dw2 returns nothing
local group g=CreateGroup()
local unit u
local real shz=LoadReal(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效伤害"))
if LoadStr(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效路径")) != "" and LoadStr(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效附着点")) != "" then
call DestroyEffectBJ(AddSpecialEffectTarget(LoadStr(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效路径")), dw, LoadStr(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效附着点"))))
endif
if LoadBoolean(ZBTZ__TZHT, GetHandleId(dw), StringHash("范围伤害开关")) == true then
call GroupEnumUnitsInRange(g, GetUnitX(dw2), GetUnitY(dw2), 350, null)
loop
set u=FirstOfGroup(g)
exitwhen u == null
call GroupRemoveUnit(g, u)
if ( IsUnitType(u, UNIT_TYPE_STRUCTURE) == false ) and ( IsUnitAliveBJ(u) == true ) and ( IsUnitEnemy(u, GetOwningPlayer(dw)) == true ) then
call UnitDamageTarget(dw, u, shz, false, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
endif
endloop
else
call UnitDamageTarget(dw, dw2, shz, false, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
endif
call XY_AddGJTXSystemTriggerAction(dw , dw2)
call DestroyGroup(g)
set u=null
endfunction
function Damage_Deal_Code_on takes nothing returns boolean
return ( ( GetEventDamage() >= 1.2 ) )
endfunction
function Damage_Deal_Code takes nothing returns nothing
local unit dw=GetEventDamageSource()
local unit dw2=GetTriggerUnit()
local real shz=GetEventDamage()
local real lv=100.00
local real lan=100.00
local real hong=100.00
local real hj=GetUnitState(dw2, ConvertUnitState(0x20))
local real s=0.00
local real s2=0.00
local real hx=0.00
local integer i=1
local string wb=""
local string zfc=""
local boolean shtype=false
if ( (0 != EXGetEventDamageData(ZBTZ__EVENT_DAMAGE_DATA_IS_ATTACK)) == true ) then // INLINED!!
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw2), ZBTZ__SHGD) ) != 0.00 then
set shz=shz * ( 1 - LoadReal(ZBTZ__TZHT, GetHandleId(dw2), ZBTZ__SHGD) )
if shz <= 0 then
set wb="免疫"
endif
endif
if ( ((WEAPON_TYPE_WHOKNOWS) == ConvertWeaponType(EXGetEventDamageData(ZBTZ__EVENT_DAMAGE_DATA_WEAPON_TYPE))) == false ) then // INLINED!!
if LoadReal(ZBTZ__TZHT, GetHandleId(dw2), ZBTZ__SBJL) > 0.00 and ( GetRandomReal(0.00, 1.00) <= LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__SBJL) ) then
set shz=0
set wb="Miss"
else
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__WLCT) > 0.00 ) then
if ( hj >= 0.00 ) then
set s=1 - ( ( hj * 0.01 ) / ( 1 + ( hj * 0.01 ) ) )
elseif ( hj >= - 20.00 ) then
set s=( 2.00 - Pow(0.94, hj) )
else
set s=1.71
endif
set hj=GetUnitState(dw2, ConvertUnitState(0x20)) * ( 1 - LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__WLCT) )
if ( hj >= 0.00 ) then
set s2=1 - ( ( hj * 0.01 ) / ( 1 + hj * 0.01 ) )
elseif ( hj >= - 20.00 ) then
set s2=2.00 - Pow(0.94, hj)
else
set s2=1.71
endif
set shz=( shz / s ) * s2
endif
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__SHDD) > 0.00 ) then
set shz=shz - LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__SHDD)
endif
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__WLXX) > 0.00 ) then
set hx=hx + shz * LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__WLXX)
endif
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__FLJV) > 0.00 ) then
if ( GetRandomReal(0.00, 1.00) <= LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__FLJV) ) then
call FL(dw , dw2 , shz * ( 1 + LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__FLJC) ))
endif
endif
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__GJTX) > 0.00 ) and ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效伤害")) ) > 0.00 then
call SaveInteger(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效次数"), LoadInteger(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效次数")) + 1)
if ( LoadInteger(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效次数")) >= R2I(LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__GJTX)) ) then
call SaveInteger(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效次数"), 0)
call TXSH(dw , dw2)
endif
endif
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__GJHX) ) != 0.00 then
set hx=hx + LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__GJHX)
endif
set i=27
loop
exitwhen i > 33
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), i) > 0 ) then
call UnitStantGJSX(dw , i)
endif
set i=i + 1
endloop
endif
endif
endif
if ( ( ((ATTACK_TYPE_HERO) == ConvertAttackType(EXGetEventDamageData(ZBTZ__EVENT_DAMAGE_DATA_ATTACK_TYPE))) == true ) ) then // INLINED!!
set shtype=false
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__WLBJ) > 0.00 and GetRandomReal(0.00, 1.00) <= LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__WLBJ) ) then
set shz=shz * ( 1 + LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__WLBJSH) )
set hong=100.00
set lv=0.00
set lan=0.00
set wb="物暴"
endif
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__WLSHZF) != 0.00 ) then
set shz=shz * ( 1 + LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__WLSHZF) )
endif
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw2), ZBTZ__WLJS) != 0.00 ) then
set shz=shz * ( 1 - LoadReal(ZBTZ__TZHT, GetHandleId(dw2), ZBTZ__WLJS) + LoadReal(ZBTZ__TZHT, GetHandleId(dw2), ZBTZ__WLCT) )
endif
endif
if ( ( ((ATTACK_TYPE_NORMAL) == ConvertAttackType(EXGetEventDamageData(ZBTZ__EVENT_DAMAGE_DATA_ATTACK_TYPE))) == true ) or ( ((ATTACK_TYPE_MAGIC) == ConvertAttackType(EXGetEventDamageData(ZBTZ__EVENT_DAMAGE_DATA_ATTACK_TYPE))) == true ) ) then // INLINED!!
set shtype=true
set shz=shz * ( 1 + LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__FSSHZF) )
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__FSBJ) > 0.00 and GetRandomReal(0.00, 1) <= LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__FSBJ) ) then
set shz=shz * ( 1 + LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__FSBJSH) )
set wb="法暴"
endif
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw2), ZBTZ__FSJS) != 0 ) then
set shz=shz * ( 1 - LoadReal(ZBTZ__TZHT, GetHandleId(dw2), ZBTZ__FSJS) + LoadReal(ZBTZ__TZHT, GetHandleId(dw2), ZBTZ__FSCT) )
endif
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__FSXX) != 0 ) then
set hx=hx + shz * LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__FSXX)
endif
endif
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__SHJC) != 0.00 ) then
set shz=shz * ( 1 + LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__SHJC) )
endif
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__ZLJC) != 0.00 ) then
set hx=hx * ( 1 + LoadReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__ZLJC) )
endif
if ( hx != 0 ) then
call SetUnitState(dw, UNIT_STATE_LIFE, GetUnitState(dw, UNIT_STATE_LIFE) + hx)
if ZBTZ__SHXS[GetPlayerId(GetOwningPlayer(dw))] == true then
call ZLPFWZ(dw , dw , "治疗" , I2S(R2I(hx)) , 31 , 100 , 5.5 , false)
endif
endif
if ( shz <= 1 ) then
set shz=0
else
set zfc=I2S(R2I(shz))
endif
call EXSetEventDamage(((shz)*1.0)) // INLINED!!
if ZBTZ__SHXS[GetPlayerId(GetOwningPlayer(dw))] == true then
if wb == "免疫" or shz == 0 then
call PFWZ(dw2 , dw , "免疫" , "0" , hong , lv , lan , shtype)
else
call PFWZ(dw , dw2 , wb , zfc , hong , lv , lan , shtype)
endif
endif
set dw=null
set dw2=null
endfunction
function XY_killUnitJsx takes nothing returns nothing
local unit dw=GetKillingUnit()
local integer i=20
loop
exitwhen i > 26
if ( LoadReal(ZBTZ__TZHT, GetHandleId(dw), i) > 0 ) then
call UnitStantGJSX(dw , i)
endif
set i=i + 1
endloop
set dw=null
endfunction
function XY_MMJSX_code takes nothing returns nothing
local integer i=34
local integer z4
local integer z2
local integer z3
local real s3
local real s
if GetUnitState(GetEnumUnit(), UNIT_STATE_LIFE) > 0.50 then
loop
exitwhen i > 40
if ( LoadReal(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), i) > 0.00 ) then
call UnitStantGJSX(GetEnumUnit() , i)
endif
set i=i + 1
endloop
set i=44
loop
exitwhen i > 46
if ( LoadReal(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), i) != 0.00 ) then
set s=LoadReal(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), i)
set z3=LoadInteger(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), i + 100)
if i == 44 then
set z4=R2I(I2R(( GetHeroStr(GetEnumUnit(), true) - z3 )) * s)
elseif i == 45 then
set z4=R2I(I2R(( GetHeroAgi(GetEnumUnit(), true) - z3 )) * s)
elseif i == 46 then
set z4=R2I(I2R(( GetHeroInt(GetEnumUnit(), true) - z3 )) * s)
endif
set z2=z4 - z3
if z2 != 0 then
call SaveInteger(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), i + 100, z4)
call XY_UnitSetBonus_WB(GetEnumUnit() , i - 36 , 1 , z2)
endif
endif
set i=i + 1
endloop
set i=47
set s=LoadReal(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), i)
set z3=LoadInteger(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), i + 100)
if s != 0 or z3 != 0 then
set s3=( GetUnitState(GetEnumUnit(), UNIT_STATE_MAX_LIFE) - I2R(z3) ) * s
call SaveInteger(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), i + 100, R2I(s3))
call XY_UnitSetBonus_WB(GetEnumUnit() , 1 , 1 , R2I(s3) - z3)
endif
set s=LoadReal(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), 49)
set z3=LoadInteger(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), 49 + 100)
if s != 0 or z3 != 0 then
set s3=( GetUnitState(GetEnumUnit(), ConvertUnitState(0x12)) - I2R(z3) ) * s
call SaveInteger(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), 49 + 100, R2I(s3))
call XY_UnitSetBonus_WB(GetEnumUnit() , 3 , 1 , R2I(s3) - z3)
endif
set s=LoadReal(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), 50)
set z3=LoadInteger(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), 50 + 100)
if s != 0 or z3 != 0 then
set s3=( GetUnitState(GetEnumUnit(), ConvertUnitState(0x20)) - I2R(z3) ) * s
call SaveInteger(ZBTZ__TZHT, GetHandleId(GetEnumUnit()), 50 + 100, R2I(s3))
call XY_UnitSetBonus_WB(GetEnumUnit() , 4 , 1 , R2I(s3) - z3)
endif
endif
endfunction
function XY_MMJSX takes nothing returns nothing
set ZBTZ__QJSJ=ZBTZ__QJSJ + 1
if ( CountUnitsInGroup(ZBTZ__heroSXG) > 0 ) then
call ForGroupBJ(ZBTZ__heroSXG, function XY_MMJSX_code)
endif
call DestroyTrigger(GetTriggeringTrigger())
endfunction
function ZBTZ__ZFCJM takes string wb returns string
local integer i=StringLength(wb)
local integer j=StringHash(wb)
local integer k=StringLength(I2S(j))
local integer v=0
local integer x=1
local string f=""
local string f2=""
if wb == "" then
return ""
endif
loop
exitwhen x > k
set v=S2I(SubString(I2S(j), x, x))
set f=f + SubString(ZBTZ__MiMa, v, v)
endloop
set x=1
loop
exitwhen x > StringLength(f)
set f2=f2 + SubString(f, StringLength(f) - x + 1, StringLength(f) - x + 1)
endloop
return f2
endfunction
function XY_Initialize takes nothing returns nothing
local timer t=CreateTimer()
local integer i=0
set ZBTZ__XYDamSystem=CreateTrigger()
call YDWESyStemAnyUnitDamagedRegistTrigger(ZBTZ__XYDamSystem)
call TriggerAddCondition(ZBTZ__XYDamSystem, Condition(function Damage_Deal_Code_on))
call TriggerAddAction(ZBTZ__XYDamSystem, function Damage_Deal_Code)
set ZBTZ__XYDamSystem=null
set ZBTZ__XYDamSystem=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(ZBTZ__XYDamSystem, EVENT_PLAYER_UNIT_DEATH)
call TriggerAddAction(ZBTZ__XYDamSystem, function XY_killUnitJsx)
set ZBTZ__XYDamSystem=null
call TimerStart(t, 1, true, function XY_MMJSX)
set t=null
call SaveInteger(ZBTZ__TZHT, ZBTZ__SDGJ, StringHash("绑定属性"), 3)
call SaveInteger(ZBTZ__TZHT, ZBTZ__SDFY, StringHash("绑定属性"), 4)
call SaveInteger(ZBTZ__TZHT, ZBTZ__SDSM, StringHash("绑定属性"), 1)
call SaveInteger(ZBTZ__TZHT, ZBTZ__SDQSX, StringHash("绑定属性"), 11)
call SaveInteger(ZBTZ__TZHT, ZBTZ__SDLL, StringHash("绑定属性"), 8)
call SaveInteger(ZBTZ__TZHT, ZBTZ__SDMJ, StringHash("绑定属性"), 9)
call SaveInteger(ZBTZ__TZHT, ZBTZ__SDZL, StringHash("绑定属性"), 10)
call SaveInteger(ZBTZ__TZHT, ZBTZ__GJGJ, StringHash("绑定属性"), 3)
call SaveInteger(ZBTZ__TZHT, ZBTZ__GJFY, StringHash("绑定属性"), 4)
call SaveInteger(ZBTZ__TZHT, ZBTZ__GJSM, StringHash("绑定属性"), 1)
call SaveInteger(ZBTZ__TZHT, ZBTZ__GJQSX, StringHash("绑定属性"), 11)
call SaveInteger(ZBTZ__TZHT, ZBTZ__GJLL, StringHash("绑定属性"), 8)
call SaveInteger(ZBTZ__TZHT, ZBTZ__GJMJ, StringHash("绑定属性"), 9)
call SaveInteger(ZBTZ__TZHT, ZBTZ__GJZL, StringHash("绑定属性"), 10)
call SaveInteger(ZBTZ__TZHT, ZBTZ__MMGJ, StringHash("绑定属性"), 3)
call SaveInteger(ZBTZ__TZHT, ZBTZ__MMFY, StringHash("绑定属性"), 4)
call SaveInteger(ZBTZ__TZHT, ZBTZ__MMSM, StringHash("绑定属性"), 1)
call SaveInteger(ZBTZ__TZHT, ZBTZ__MMQSX, StringHash("绑定属性"), 11)
call SaveInteger(ZBTZ__TZHT, ZBTZ__MMLL, StringHash("绑定属性"), 8)
call SaveInteger(ZBTZ__TZHT, ZBTZ__MMMJ, StringHash("绑定属性"), 9)
call SaveInteger(ZBTZ__TZHT, ZBTZ__MMZL, StringHash("绑定属性"), 10)
call SaveInteger(ZBTZ__TZHT, ZBTZ__LLBFB, StringHash("绑定属性"), 12)
call SaveInteger(ZBTZ__TZHT, ZBTZ__MJBFB, StringHash("绑定属性"), 13)
call SaveInteger(ZBTZ__TZHT, ZBTZ__ZLBFB, StringHash("绑定属性"), 14)
call SaveInteger(ZBTZ__TZHT, ZBTZ__SMBFB, StringHash("绑定属性"), 15)
call SaveBoolean(ZBTZ__TZHT, StringHash("加成方式"), 1, false)
loop
exitwhen i > 9
set ZBTZ__WLSHZT[i]="war3mapImported\\Dawn_" + I2S(i) + ".mdl"
set ZBTZ__FSSHZT[i]="war3mapImported\\Mawn_" + I2S(i) + ".mdl"
set i=i + 1
endloop
set ZBTZ__WLSHZT[10]="war3mapImported\\Dawn_BJ.mdl"
set ZBTZ__FSSHZT[10]="war3mapImported\\Mawn_FBJ.mdl"
set ZBTZ__WLSHZT[11]="war3mapImported\\Dawn_W.mdl"
set ZBTZ__FSSHZT[11]="war3mapImported\\Mawn_W.mdl"
set ZBTZ__WLSHZT[12]="war3mapImported\\Dawn_FL.mdl"
set ZBTZ__WLSHZT[13]="war3mapImported\\Dawn_MY.mdl"
endfunction

//library ZBTZ ends
//library JKmimui:

function JK_001 takes real X1,real Y1,real X2,real Y2 returns real
return SquareRoot(Pow(( X2 - X1 ), 2.00) + Pow(( Y2 - Y1 ), 2.00))
endfunction
function JK_002 takes real X1,real Y1,real X2,real Y2 returns real
return Atan2(Y2 - Y1, X2 - X1) * bj_RADTODEG
endfunction
function JK_X takes real R,real x1 returns real
local real Rran=GetRandomReal(0, R)
return ( Cos(GetRandomReal(0, 360)) * Rran + x1 )
endfunction
function JK_Y takes real R,real y1 returns real
local real Rran=GetRandomReal(0, R)
return ( Sin(GetRandomReal(0, 360)) * Rran + y1 )
endfunction
function JK_Round takes real R,real x1,real y1 returns location
local real Rran=GetRandomReal(0, R)
local real X=Cos(GetRandomReal(0, 360)) * Rran + x1
local real Y=Sin(GetRandomReal(0, 360)) * Rran + y1
return Location(X, Y)
endfunction
function JK_Skill takes unit WHO,integer ABI,integer LV,boolean JUDE returns nothing
if ( LV > 0 ) then
call UnitAddAbility(WHO, ABI)
call SetUnitAbilityLevel(WHO, ABI, LV)
call UnitMakeAbilityPermanent(WHO, JUDE, ABI)
else
call UnitRemoveAbility(WHO, ABI)
endif
endfunction
function JK_CameraUse takes player WP,real LDx,real LDy,real RUx,real RUy returns nothing
if ( GetLocalPlayer() == WP ) then
call SetCameraBounds(LDx, LDy, LDx, RUy, RUx, LDy, RUx, RUy)
endif
endfunction
function JK_CameraControl takes player PL,camerafield CamFie,integer CON,real REAL,real S,real Rmax,real Rmin,string STR returns nothing
local real A=GetCameraField(CamFie)
if ( CON == bj_MODIFYMETHOD_ADD ) then
set A=A + REAL
elseif ( CON == bj_MODIFYMETHOD_SUB ) then
set A=A - REAL
elseif ( CON == bj_MODIFYMETHOD_SET ) then
endif
if ( A >= Rmin ) and ( A <= Rmax ) and ( GetLocalPlayer() == PL ) then
call SetCameraField(CamFie, A, S)
else
call DisplayTextToPlayer(PL, 0, 0, STR)
endif
endfunction
function JK_CameraTranslation takes player PL,real X,real Y,real S returns nothing
if ( PL == GetLocalPlayer() ) then
call PanCameraToTimed(X, Y, S)
endif
endfunction
function JK_AddItem takes itemtype IT returns nothing
local integer LOOP=0
local integer a=GetItemCharges(GetManipulatedItem())
local integer b=0
if ( ( GetItemType(GetManipulatedItem()) == IT ) ) then
loop
exitwhen LOOP == 6
if ( GetManipulatedItem() != UnitItemInSlot(GetManipulatingUnit(), LOOP) ) and ( GetItemTypeId(GetManipulatedItem()) == GetItemTypeId(UnitItemInSlot(GetManipulatingUnit(), LOOP)) ) and ( GetItemCharges(GetManipulatedItem()) > 0 ) then
set b=GetItemCharges(UnitItemInSlot(GetManipulatingUnit(), LOOP))
call SetItemCharges(UnitItemInSlot(GetManipulatingUnit(), LOOP), ( a + b ))
call RemoveItem(GetManipulatedItem())
endif
set LOOP=LOOP + 1
endloop
endif
endfunction
function JK_LvLimitItem takes integer LV,string STR,integer MODE returns nothing
local integer i=0
local real X=GetUnitX(GetManipulatingUnit())
local real Y=GetUnitY(GetManipulatingUnit())
local player PL=GetOwningPlayer(GetManipulatingUnit())
if ( GetItemLevel(GetManipulatedItem()) == LV ) then
loop
exitwhen i > 5
if ( LV == GetItemLevel(UnitItemInSlot(GetManipulatingUnit(), i)) ) and ( GetManipulatedItem() != UnitItemInSlot(GetManipulatingUnit(), i) ) then
if ( MODE == 0 ) then
call CreateItem(GetItemTypeId(GetManipulatedItem()), X, Y)
call RemoveItem(GetManipulatedItem())
elseif ( MODE == 1 ) then
call UnitDropItemPoint(GetManipulatingUnit(), GetManipulatedItem(), X, Y)
elseif ( MODE == 2 ) then
call SetItemPosition(GetManipulatedItem(), X, Y)
endif
call DisplayTextToPlayer(PL, 0.00, 0.00, STR)
endif
set i=i + 1
endloop
endif
set PL=null
endfunction
function JK_TypeLimitItem takes integer TYPE,string STR,integer MODE returns nothing
local integer i=0
local real X=GetUnitX(GetManipulatingUnit())
local real Y=GetUnitY(GetManipulatingUnit())
local player PL=GetOwningPlayer(GetManipulatingUnit())
if ( GetItemTypeId(GetManipulatedItem()) == TYPE ) then
loop
exitwhen i > 5
if ( TYPE == GetItemTypeId(UnitItemInSlot(GetManipulatingUnit(), i)) ) and ( GetManipulatedItem() != UnitItemInSlot(GetManipulatingUnit(), i) ) then
if ( MODE == 0 ) then
call CreateItem(TYPE, X, Y)
call RemoveItem(GetManipulatedItem())
elseif ( MODE == 1 ) then
call UnitDropItemPoint(GetManipulatingUnit(), GetManipulatedItem(), X, Y)
elseif ( MODE == 2 ) then
call SetItemPosition(GetManipulatedItem(), X, Y)
endif
call DisplayTextToPlayer(PL, 0, 0, STR)
endif
set i=i + 1
endloop
endif
set PL=null
endfunction
function JK_HeroResurrectionB takes nothing returns nothing
local timer T=GetExpiredTimer()
local timerdialog TD=LoadTimerDialogHandle(JK_HT, GetHandleId(T), 20)
local real X=LoadReal(JK_HT, GetHandleId(T), 1)
local real Y=LoadReal(JK_HT, GetHandleId(T), 2)
local unit HERO=LoadUnitHandle(JK_HT, GetHandleId(T), 10)
local boolean BL=LoadBoolean(JK_HT, GetHandleId(T), 11)
call ReviveHero(HERO, X, Y, true)
if ( BL == true ) then
if ( GetOwningPlayer(HERO) == GetLocalPlayer() ) then
call PanCameraToTimed(X, Y, 0.50)
endif
endif
call FlushChildHashtable(JK_HT, GetHandleId(T))
call DestroyTimerDialog(TD)
call DestroyTimer(T)
set T=null
set TD=null
set HERO=null
endfunction
function JK_HeroResurrectionA takes nothing returns nothing
local timer T=CreateTimer()
local timerdialog TD=CreateTimerDialog(T)
local real SJ=LoadReal(JK_HT, GetHandleId(GetTriggeringTrigger()), 0)
local real X=LoadReal(JK_HT, GetHandleId(GetTriggeringTrigger()), 1)
local real Y=LoadReal(JK_HT, GetHandleId(GetTriggeringTrigger()), 2)
local unit HERO=LoadUnitHandle(JK_HT, GetHandleId(GetTriggeringTrigger()), 10)
local boolean BL=LoadBoolean(JK_HT, GetHandleId(GetTriggeringTrigger()), 11)
call SaveReal(JK_HT, GetHandleId(T), 1, X)
call SaveReal(JK_HT, GetHandleId(T), 2, Y)
call SaveUnitHandle(JK_HT, GetHandleId(T), 10, HERO)
call SaveBoolean(JK_HT, GetHandleId(T), 11, BL)
call SaveTimerDialogHandle(JK_HT, GetHandleId(T), 20, TD)
call TimerDialogDisplay(TD, true)
call TimerDialogSetTitle(TD, GetPlayerName(GetOwningPlayer(HERO)) + "复活：")
call TimerStart(T, SJ, false, function JK_HeroResurrectionB)
set T=null
set TD=null
set HERO=null
endfunction
function JK_HeroResurrection takes unit HERO,real SJ,real X,real Y,boolean BL returns nothing
local trigger TRI=CreateTrigger()
call TriggerRegisterUnitEvent(TRI, HERO, EVENT_UNIT_DEATH)
call TriggerAddAction(TRI, function JK_HeroResurrectionA)
call SaveReal(JK_HT, GetHandleId(TRI), 0, SJ)
call SaveReal(JK_HT, GetHandleId(TRI), 1, X)
call SaveReal(JK_HT, GetHandleId(TRI), 2, Y)
call SaveUnitHandle(JK_HT, GetHandleId(TRI), 10, HERO)
call SaveBoolean(JK_HT, GetHandleId(TRI), 11, BL)
set TRI=null
endfunction
function JK_GetSW takes unit HERO,boolean BL,boolean BLstr,boolean BLagi,boolean BLint returns integer
local integer SW=0
if ( BLstr == true ) then
set SW=SW + GetHeroStr(HERO, BL)
endif
if ( BLagi == true ) then
set SW=SW + GetHeroAgi(HERO, BL)
endif
if ( BLint == true ) then
set SW=SW + GetHeroInt(HERO, BL)
endif
return SW
endfunction
function JK_SetSw takes unit HERO,boolean BLstr,boolean BLagi,boolean BLint,integer MM,integer VL,boolean BL returns nothing
local integer STR=GetHeroStr(HERO, false)
local integer AGI=GetHeroAgi(HERO, false)
local integer INT=GetHeroInt(HERO, false)
if ( MM == bj_MODIFYMETHOD_ADD ) then
if ( BLstr == true ) then
set STR=STR + VL
endif
if ( BLagi == true ) then
set AGI=AGI + VL
endif
if ( BLint == true ) then
set INT=INT + VL
endif
elseif ( MM == bj_MODIFYMETHOD_SUB ) then
if ( BLstr == true ) then
set STR=STR - VL
endif
if ( BLagi == true ) then
set AGI=AGI - VL
endif
if ( BLint == true ) then
set INT=INT - VL
endif
elseif ( MM == bj_MODIFYMETHOD_SET ) then
endif
call SetHeroStr(HERO, STR, BL)
call SetHeroAgi(HERO, AGI, BL)
call SetHeroInt(HERO, INT, BL)
endfunction
function JK_RouDam takes unit U,real R,real X,real Y,real DAM,string SP,boolean AT,boolean RE,attacktype ATTYPE,damagetype DAMTYPE,weapontype WEATYPE returns nothing
local group a
local unit b
set a=CreateGroup()
call GroupEnumUnitsInRange(a, X, Y, R, null)
loop
set b=FirstOfGroup(a)
exitwhen b == null
call GroupRemoveUnit(a, b)
if ( IsUnitEnemy(b, GetOwningPlayer(U)) == true ) and ( UnitAlive(b) == true ) then
call UnitDamageTarget(U, b, DAM, AT, RE, ATTYPE, DAMTYPE, WEATYPE)
call DestroyEffect(AddSpecialEffect(SP, GetUnitX(b), GetUnitY(b)))
endif
endloop
call DestroyGroup(a)
set a=null
set b=null
endfunction
function JK_RouDam2 takes unit U,real R,real X,real Y,real DAM,real SJ,string SP,boolean AT,boolean RE,attacktype ATTYPE,damagetype DAMTYPE,weapontype WEATYPE returns nothing
local group a
local unit b
set a=CreateGroup()
call GroupEnumUnitsInRange(a, X, Y, R, null)
loop
set b=FirstOfGroup(a)
exitwhen b == null
call GroupRemoveUnit(a, b)
if ( IsUnitEnemy(b, GetOwningPlayer(U)) == true ) and ( UnitAlive(b) == true ) then
call UnitDamageTarget(U, b, DAM, AT, RE, ATTYPE, DAMTYPE, WEATYPE)
call YDWETimerDestroyEffect(SJ , AddSpecialEffect(SP, GetUnitX(b), GetUnitY(b)))
endif
endloop
call DestroyGroup(a)
set a=null
set b=null
endfunction
function JK_RandomUnitInRange takes real X,real Y,real R,boolexpr F returns unit
local group G=CreateGroup()
local unit U
call GroupEnumUnitsInRange(G, X, Y, R, F)
set U=GroupPickRandomUnit(G)
call DestroyGroup(G)
set G=null
return U
set U=null
endfunction
function JK_CreatUnitAtRectXY takes player ID,integer LOOP,integer U,real X1,real Y1,real X2,real Y2,real FACE returns nothing
local real Xran
local real Yran
local integer xh=0
loop
exitwhen xh == LOOP
set xh=xh + 1
if ( X1 < X2 ) then
set Xran=GetRandomReal(X1, X2)
else
set Xran=GetRandomReal(X2, X1)
endif
if ( Y1 < Y2 ) then
set Yran=GetRandomReal(Y1, Y2)
else
set Yran=GetRandomReal(Y2, Y1)
endif
call CreateUnit(ID, U, Xran, Yran, FACE)
endloop
endfunction
function JK_CreatUnitAtRound takes player ID,integer LOOP,integer U,real X,real Y,real R,real D,real FACE returns nothing
local real Rran
local real Dran
local real Xran
local real Yran
local integer xh=0
loop
exitwhen xh == LOOP
set xh=xh + 1
set Rran=GetRandomReal(0.00, R)
set Dran=GetRandomReal(0.00, D)
set Xran=Cos(Dran) * Rran + X
set Yran=Sin(Dran) * Rran + Y
call CreateUnit(ID, U, Xran, Yran, FACE)
endloop
endfunction
function JK_CreatUnitAtRect takes player ID,integer LOOP,integer U,rect QY,real FACE returns nothing
local real Xran
local real Yran
local real Xmin=GetRectMinX(QY)
local real Xmax=GetRectMaxX(QY)
local real Ymin=GetRectMinY(QY)
local real Ymax=GetRectMaxY(QY)
local integer xh=0
loop
exitwhen xh == LOOP
set xh=xh + 1
set Xran=GetRandomReal(Xmin, Xmax)
set Yran=GetRandomReal(Ymin, Ymax)
call CreateUnit(ID, U, Xran, Yran, FACE)
endloop
endfunction
function JK_CreatBossAtRect takes integer DEATH,integer COUNT,player ID,integer LOOP,integer U,rect RECT,real FACE,string STR returns nothing
local integer i=LoadInteger(JK_HT, GetHandleId(RECT), DEATH)
if ( GetUnitTypeId(GetDyingUnit()) == DEATH ) then
set i=i + 1
if i >= COUNT then
call SaveInteger(JK_HT, GetHandleId(RECT), DEATH, 0)
call JK_CreatUnitAtRect(ID , LOOP , U , RECT , FACE)
call DisplayTextToPlayer(GetOwningPlayer(GetKillingUnit()), 0.00, 0.00, STR)
else
call SaveInteger(JK_HT, GetHandleId(RECT), DEATH, i)
endif
endif
endfunction
function JK_CreatBossAtXY takes integer DEATH,integer COUNT,player ID,integer U,real X,real Y,real FACE,string STR returns nothing
local integer i=LoadInteger(JK_HT, DEATH, 10000)
if ( GetUnitTypeId(GetDyingUnit()) == DEATH ) then
set i=i + 1
if i >= COUNT then
call SaveInteger(JK_HT, DEATH, 10000, 0)
call CreateUnit(ID, U, X, Y, FACE)
call DisplayTextToPlayer(GetOwningPlayer(GetKillingUnit()), 0.00, 0.00, STR)
else
call SaveInteger(JK_HT, DEATH, 10000, i)
endif
endif
endfunction
function JK_TreasureDrop takes integer DEATH,integer ITEM,integer I1,integer I2 returns nothing
if ( GetUnitTypeId(GetTriggerUnit()) == DEATH ) and ( I1 >= GetRandomInt(1, I2) ) then
call CreateItem(ITEM, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
endif
endfunction
function JK_UnitTranslation_Timer takes nothing returns nothing
local timer T=GetExpiredTimer()
local effect EF=LoadEffectHandle(JK_HT, GetHandleId(T), 0)
call DestroyEffect(EF)
call FlushChildHashtable(JK_HT, GetHandleId(T))
call DestroyTimer(T)
set T=null
set EF=null
endfunction
function JK_UnitTranslationA takes integer ITEM,unit U,real X,real Y,effect EF,real SJ,string S,boolean BL returns nothing
local timer T=CreateTimer()
if ( GetItemTypeId(GetManipulatedItem()) == ITEM ) and ( GetManipulatingUnit() == U ) then
call SetUnitPosition(U, X, Y)
call TimerStart(T, SJ, false, function JK_UnitTranslation_Timer)
call SaveEffectHandle(JK_HT, GetHandleId(T), 0, EF)
call DisplayTextToPlayer(GetOwningPlayer(U), 0.00, 0.00, S)
if ( BL == true ) then
if ( GetOwningPlayer(U) == GetLocalPlayer() ) then
call PanCameraToTimed(X, Y, 0.2)
endif
endif
endif
set T=null
endfunction
function JK_UnitTranslationB takes unit U,real X,real Y,effect EF,real SJ,string S,boolean BL returns nothing
local timer T=CreateTimer()
call SetUnitPosition(U, X, Y)
call TimerStart(T, SJ, false, function JK_UnitTranslation_Timer)
call SaveEffectHandle(JK_HT, GetHandleId(T), 0, EF)
call DisplayTextToPlayer(GetOwningPlayer(U), 0.00, 0.00, S)
if ( BL == true ) then
if ( GetOwningPlayer(U) == GetLocalPlayer() ) then
call PanCameraToTimed(X, Y, 0.2)
endif
endif
set T=null
endfunction
