function XY_unitSetStantReal takes unit dw,integer bonusType,integer mod,real s returns nothing
local integer j=44
local real i=0
local boolean t=false
if mod == - 1 then
set s=s * - 1
endif
if mod == 0 then
call SaveReal(ZBTZ__TZHT, GetHandleId(dw), bonusType, s)
else
call SaveReal(ZBTZ__TZHT, GetHandleId(dw), bonusType, LoadReal(ZBTZ__TZHT, GetHandleId(dw), bonusType) + s)
endif
if bonusType >= 44 and bonusType <= 50 then
if IsUnitInGroup(dw, ZBTZ__heroSXG) == true then
loop
exitwhen j > 50
set i=LoadReal(ZBTZ__TZHT, GetHandleId(dw), j)
if i > 0 then
set j=50
set t=true
endif
set j=j + 1
endloop
if t == false then
call GroupRemoveUnit(ZBTZ__heroSXG, dw)
endif
elseif LoadReal(ZBTZ__TZHT, GetHandleId(dw), bonusType) > 0.00 then
call GroupAddUnit(ZBTZ__heroSXG, dw)
endif
endif
endfunction
function XY_unitTxAttack takes unit dw,integer cs,real shz,string tx,string pointUnit,boolean t returns nothing
if ( cs == 0 ) then
call SaveReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__GJTX, 0.00)
call SaveReal(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效伤害"), 0.00)
call SaveStr(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效路径"), "")
call SaveStr(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效附着点"), "")
call SaveBoolean(ZBTZ__TZHT, GetHandleId(dw), StringHash("范围伤害开关"), false)
else
call SaveReal(ZBTZ__TZHT, GetHandleId(dw), ZBTZ__GJTX, cs)
call SaveReal(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效伤害"), shz)
call SaveStr(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效路径"), tx)
call SaveStr(ZBTZ__TZHT, GetHandleId(dw), StringHash("特效附着点"), pointUnit)
call SaveBoolean(ZBTZ__TZHT, GetHandleId(dw), StringHash("范围伤害开关"), t)
endif
endfunction
function XY_unitSetStantSD takes unit dw,integer mod,integer mod2,real s returns nothing
local real i=0
local integer j=34
local boolean t=false
if mod2 == - 1 then
set s=- s
endif
if mod2 == 0 then
call SaveReal(ZBTZ__TZHT, GetHandleId(dw), mod, s)
else
call SaveReal(ZBTZ__TZHT, GetHandleId(dw), mod, LoadReal(ZBTZ__TZHT, GetHandleId(dw), mod) + s)
endif
if mod >= 34 and mod <= 40 then
if IsUnitInGroup(dw, ZBTZ__heroSXG) == true then
loop
exitwhen j > 50
set i=LoadReal(ZBTZ__TZHT, GetHandleId(dw), j)
if i > 0 then
set j=50
set t=true
endif
set j=j + 1
endloop
if t == false then
call GroupRemoveUnit(ZBTZ__heroSXG, dw)
endif
elseif LoadReal(ZBTZ__TZHT, GetHandleId(dw), mod) > 0.00 then
call GroupAddUnit(ZBTZ__heroSXG, dw)
endif
endif
endfunction
function XY_unitSetStantQT takes unit dw,integer mod,integer mod2,real s returns nothing
if mod2 == - 1 then
set s=s * - 1
endif
if mod2 == 0 then
call SaveReal(ZBTZ__TZHT, GetHandleId(dw), mod, s)
else
call SaveReal(ZBTZ__TZHT, GetHandleId(dw), mod, LoadReal(ZBTZ__TZHT, GetHandleId(dw), mod) + s)
endif
endfunction
